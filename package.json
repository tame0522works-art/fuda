{
  "name": "fuda",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "即売会のお品書き・ポップ・値札を、ブラウザの中だけで作る",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "check:wrap": "tsx tools/check-wrap.ts",
    "check:sheet": "tsx tools/check-sheet.ts",
    "check:pdf": "tsx tools/check-pdf.ts",
    "check:tsuri": "tsx tools/check-tsuri.ts",
    "check:snap": "tsx tools/check-snap.ts",
    "check:doc": "tsx tools/check-doc.ts",
    "check": "npm run check:wrap && npm run check:sheet && npm run check:pdf && npm run check:tsuri && npm run check:snap && npm run check:doc"
  },
  "dependencies": {
    "@fontsource/dela-gothic-one": "^5.3.0",
    "@fontsource/dotgothic16": "^5.3.0",
    "@fontsource/klee-one": "^5.3.0",
    "@fontsource/rocknroll-one": "^5.3.0",
    "@fontsource/yomogi": "^5.3.0",
    "@fontsource/zen-maru-gothic": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
